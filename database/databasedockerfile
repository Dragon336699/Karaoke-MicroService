FROM mcr.microsoft.com/mssql/server:2022-latest

ENV ACCEPT_EULA=Y
ENV SA_PASSWORD=Longlatoi1409@

# Ensure we are running as root user (explicitly)
USER root

# Update package list and install mssql-tools
RUN apt-get update && apt-get install -y mssql-tools

# Add /opt/mssql-tools/bin to PATH
ENV PATH="$PATH:/opt/mssql-tools/bin"

COPY init.sql /init.sql

CMD sh -c "/opt/mssql/bin/sqlservr & \
    echo 'Waiting for SQL Server to start...' && \
    while ! sqlcmd -S localhost -U sa -P '$SA_PASSWORD' -Q 'SELECT 1'; do \
        sleep 5; \
        echo 'SQL Server is not yet ready...'; \
    done && \
    echo 'SQL Server started and is ready.' && \
    sqlcmd -S localhost -U sa -P '$SA_PASSWORD' -i /init.sql && \
    tail -f /dev/null"